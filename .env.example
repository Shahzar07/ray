# ---------------------------------------------------------------------------
# CallDesk environment
# Copy to .env (local) or paste into Vercel → Project → Settings → Environment.
# Every service listed here has a free tier. Total recurring cost: $0.
# ---------------------------------------------------------------------------

# Postgres connection string used by the app.
#
#   Supabase (recommended): Project → Settings → Database → Connection string →
#   the "Transaction pooler" URI, port 6543. Serverless functions open a lot of
#   short-lived connections and the pooler is what survives that.
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   Neon: the *pooled* connection string from the Neon console.
#   Local dev: any Postgres 14+. The driver is picked automatically from the URL.
DATABASE_URL=

# Direct (non-pooled) connection, used only by migrations and the seed script.
# DDL does not belong on a transaction pooler. On Supabase this is the same
# credentials on port 5432. Leave blank if DATABASE_URL is already direct.
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Session signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of the deployment. Optional on Vercel (inferred), required if
# you run behind a proxy or a custom domain locally.
AUTH_URL=http://localhost:3000

# Shared secret guarding /api/cron/*. Vercel Cron sends it as a bearer token.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI (optional). LEAVE BLANK and the app runs fully without it — every AI
# surface simply does not render. Nothing else changes.
# ---------------------------------------------------------------------------

# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fallback chain, tried in order. OpenRouter serves the first that answers.
# This matters: free models rate-limit hard and independently, so a single id
# makes the AI features flaky. All of these are $0.
# Only the first has been verified to reliably return valid JSON; the rest are
# there to cover it when it is busy, and anything unusable is discarded by the
# schema check rather than shown to a caller.
# OpenRouter rejects more than three, and the code caps it there too.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,google/gemma-4-31b-it:free

# Sent to OpenRouter for attribution on its dashboard. Optional.
OPENROUTER_SITE_URL=

# ISO-3166 alpha-2 country used when an imported phone number has no + prefix.
DEFAULT_COUNTRY=PK
