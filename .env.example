# ---------------------------------------------------------------------------
# CallDesk environment
# Copy to .env (local) or paste into Vercel → Project → Settings → Environment.
# Every service listed here has a free tier. Total recurring cost: $0.
# ---------------------------------------------------------------------------

# Postgres connection string.
#   Neon (production): grab the *pooled* connection string from the Neon console.
#     postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/calldesk?sslmode=require
#   Local dev: any Postgres 14+ works; the app picks the driver automatically.
DATABASE_URL=

# Session signing key. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of the deployment. Optional on Vercel (inferred), required if
# you run behind a proxy or a custom domain locally.
AUTH_URL=http://localhost:3000

# Shared secret guarding /api/cron/*. Vercel Cron sends it as a bearer token.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Groq free tier — powers the optional AI features (note → structured update,
# objection coach, nightly brief). LEAVE BLANK and the app runs fully without
# them; every AI surface degrades to a plain manual control.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ISO-3166 alpha-2 country used when an imported phone number has no + prefix.
DEFAULT_COUNTRY=PK
